{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.mjs": {
      "memory": 256,
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/groq/:path*", "destination": "https://api.groq.com/openai/v1/:path*" },
    { "source": "/higgsfield/:path*", "destination": "https://api.higgsfield.ai/:path*" },
    { "source": "/xai/:path*", "destination": "https://api.x.ai/v1/:path*" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
