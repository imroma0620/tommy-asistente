# Copia a .env.local para desarrollo (no commitees .env.local)

# --- Vercel (servidor, Settings → Environment Variables) ---
# Upstash Redis REST (free tier): https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx

# O Supabase service role (servidor solamente, nunca en Vite):
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE=eyJ...

TOMMY_WORKSPACE=im-roma-diana
TOMMY_API_TOKEN=genera-con-openssl-rand-hex-32

# --- Cliente Vite (solo si hace falta en build) ---
# En Vercel NO hace falta VITE_SYNC_URL (mismo origen /api/state).
# En GitHub Pages, apunta a Vercel:
# VITE_SYNC_URL=https://tommy-asistente.vercel.app

# Supabase directo desde la PWA (alternativa a VITE_SYNC_URL):
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...
# VITE_TOMMY_WORKSPACE=im-roma-diana
