# Sincronización en la nube (elige una opción)

# Opción A — Supabase directo desde la PWA (recomendado con GitHub Pages)
# Ejecuta supabase/schema.sql en tu proyecto y pega URL + anon key:
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_TOMMY_WORKSPACE=im-roma-diana

# Opción B — API en Vercel (misma repo, carpeta /api)
# Despliega en Vercel con UPSTASH o SUPABASE_SERVICE_ROLE en el servidor:
VITE_SYNC_URL=https://tu-proyecto.vercel.app

# Token para escrituras externas (Grok Bot, scripts). En Vercel/local server:
TOMMY_API_TOKEN=pon-un-secreto-largo
